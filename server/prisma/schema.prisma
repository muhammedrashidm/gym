// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ExpLevel {
  BEGINNER
  INTERMEDIATE
  PRO
}

enum PlanType {
  MONTHLY
  ANNUAL
  CLASS
  PUNCH_CARD
}

enum MembershipStatus {
  PAID
  UNPAID
  ACTIVE_KINETIC
}

// ─────────────────────────────────────────
// IDENTITY & AUTH
// ─────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  profile           Profile?
  userRoles         UserRole[]
  refreshTokens     RefreshToken[]
  otpRequests       OtpRequest[]
  gyms              Gym[]
  invites           Invite[]
  staffAttendances  StaffAttendance[]
  gymSessionRates   GymSessionRate[]
  payoutBatches     PayoutBatch[]
  ownerBankAccounts OwnerBankAccount[]
}

model OtpRequest {
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// USER PROFILE  (Hybrid Bridge)
// ─────────────────────────────────────────
model Profile {
  id               String            @id @default(uuid())
  phoneNumber      String            @unique // claim key
  fullName         String
  age              Int?
  sex              Sex?
  expLevel         ExpLevel? //not used
  isKinetic        Boolean           @default(false) // not used
  isClaimed        Boolean           @default(false) // gym-managed → claimed
  createdById      String? // staff userId
  createdAtGymId   String?
  avatarUrl        String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  qrToken          String?           @unique // ⚑ ADD
  qrTokenExpiry    DateTime? // ⚑ ADD
  userId           String?           @unique // null = unclaimed
  user             User?             @relation(fields: [userId], references: [id])
  memberships      Membership[]
  gymSubscriptions GymSubscription[]
  checkIns         CheckIn[]
  bodyMetrics      BodyMetrics[]
  workoutPlans     WorkoutPlan[]
  dietPlans        DietPlan[]
  transactions     Transaction[]
  sessionPayouts   SessionPayout[]
}

// ─────────────────────────────────────────
// GYM
// ─────────────────────────────────────────

model Gym {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now())
  ownerId          String // ⚑ ADD
  tier             Int               @default(3) // ⚑ ADD, set by admin
  isApproved       Boolean           @default(false) // ⚑ ADD
  address          String? // ⚑ ADD
  lat              Float? // ⚑ ADD — geofence anchor
  lng              Float? // ⚑ ADD
  logoUrl          String? // ⚑ ADD
  owner            User              @relation(fields: [ownerId], references: [id])
  userRoles        UserRole[]
  memberships      Membership[]
  gymPlans         GymPlan[]
  gymSubscriptions GymSubscription[]
  checkIns         CheckIn[]
  sessionRates     GymSessionRate[]
  staffAttendance  StaffAttendance[]
  sessionPayouts   SessionPayout[]
  payoutBatches    PayoutBatch[]
  invites          Invite[]
}

// ─────────────────────────────────────────
// DYNAMIC ROLES
// ─────────────────────────────────────────

model Role {
  id          Int        @id
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  userRoles   UserRole[]
  invites     Invite[]
}

model UserRole {
  id         String   @id @default(uuid())
  assignedAt DateTime @default(now())
  assignedBy String?
  // null gymId = global (SuperAdmin, AdminStaff, Member)
  // set gymId = scoped to that gym (Owner, Staff)
  gymId      String?
  gym        Gym?     @relation(fields: [gymId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     Int
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, gymId])
}

// ─────────────────────────────────────────
// MEMBERSHIPS & BILLING
// ─────────────────────────────────────────

model Membership {
  id               String           @id @default(uuid())
  planType         PlanType // existing enum
  status           MembershipStatus // existing enum
  autoDebit        Boolean          @default(false)
  expiryDate       DateTime?
  createdAt        DateTime         @default(now())
  gymId            String? // ⚑ make nullable
  platformPlanId   String // ⚑ ADD FK
  paymentMandateId String? // ⚑ ADD Razorpay sub ID
  profileId        String
  profile          Profile          @relation(fields: [profileId], references: [id])
  platformPlan     PlatformPlan     @relation(fields: [platformPlanId], references: [id])
  gym              Gym?             @relation(fields: [gymId], references: [id])
  transactions     Transaction[]
}

// Stores progressive data for AI/Trainers to track and graph
model BodyMetrics {
  id         String   @id @default(uuid())
  weight     Float
  height     Float
  muscleMass Float?
  bodyFatPct Float?
  recordedAt DateTime @default(now())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id])
}

// ─────────────────────────────────────────
// MEDIA
// ─────────────────────────────────────────
model Media {
  id        String   @id @default(uuid())
  url       String
  type      String
  createdAt DateTime @default(now())
}

model PlatformPlan {
  id           String       @id @default(uuid())
  name         String // e.g. "Premium"
  tier         Int // 1=highest, N=basic
  price        Float // monthly INR
  billingCycle String // "MONTHLY"|"ANNUAL"
  isActive     Boolean      @default(true)
  features     Json // feature flag object
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model GymPlan {
  id               String            @id @default(uuid())
  name             String // e.g. "Morning 3-Month"
  planType         PlanType // reuse existing enum
  price            Float
  durationDays     Int? // MONTHLY/ANNUAL
  sessionCount     Int? // CLASS/PUNCH_CARD
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  gymId            String
  gym              Gym               @relation(fields: [gymId], references: [id])
  gymSubscriptions GymSubscription[]
}

enum SubStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PENDING_MANDATE
}

model GymSubscription {
  id             String        @id @default(uuid())
  status         SubStatus     @default(PENDING_MANDATE)
  autoDebit      Boolean       @default(false)
  mandateRef     String? // Razorpay mandate ID
  startDate      DateTime
  expiryDate     DateTime?
  addedByStaffId String?
  createdAt      DateTime      @default(now())
  profileId      String
  profile        Profile       @relation(fields: [profileId], references: [id])
  gymPlanId      String
  gymPlan        GymPlan       @relation(fields: [gymPlanId], references: [id])
  gymId          String // denormalized
  gym            Gym           @relation(fields: [gymId], references: [id])
  transactions   Transaction[]
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Invite {
  id              String       @id @default(uuid())
  phoneNumber     String
  token           String       @unique // deep link token
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  invitedByUserId String
  invitedBy       User         @relation(fields: [invitedByUserId], references: [id])
  roleId          Int
  role            Role         @relation(fields: [roleId], references: [id])
  gymId           String? // null = platform-level invite
  gym             Gym?         @relation(fields: [gymId], references: [id])
}

model CheckIn {
  id               String         @id @default(uuid())
  method           String // "QR_SCAN"|"MANUAL"
  accessGranted    Boolean
  denyReason       String? // "TIER_MISMATCH"|"EXPIRED_PLAN"
  checkInAt        DateTime       @default(now())
  checkOutAt       DateTime?
  profileId        String
  profile          Profile        @relation(fields: [profileId], references: [id])
  gymId            String
  gym              Gym            @relation(fields: [gymId], references: [id])
  scannedByStaffId String?
  sessionPayout    SessionPayout? // created if platform member
}

model StaffAttendance {
  id               String    @id @default(uuid())
  lat              Float // GPS at check-in
  lng              Float
  isWithinGeofence Boolean // haversine vs gym lat/lng
  checkInAt        DateTime  @default(now())
  checkOutAt       DateTime?
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  gymId            String
  gym              Gym       @relation(fields: [gymId], references: [id])
}

model WorkoutPlan {
  id                String    @id @default(uuid())
  title             String
  schedule          Json // day-wise exercises
  startDate         DateTime
  endDate           DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  profileId         String
  profile           Profile   @relation(fields: [profileId], references: [id])
  assignedByStaffId String? // null = self
}

model DietPlan {
  id                String   @id @default(uuid())
  title             String
  mealPlan          Json // meals, macros, calories
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id])
  assignedByStaffId String?
}

model Transaction {
  id                String           @id @default(uuid())
  amount            Float
  platformFee       Float // 5%
  gymAmount         Float // 95%
  status            String // SUCCESS|FAILED|REFUNDED
  gateway           String // "RAZORPAY"
  gatewayRef        String?
  createdAt         DateTime         @default(now())
  profileId         String
  profile           Profile          @relation(fields: [profileId], references: [id])
  gymSubscriptionId String?
  gymSubscription   GymSubscription? @relation(fields: [gymSubscriptionId], references: [id])
  membershipId      String?
  membership        Membership?      @relation(fields: [membershipId], references: [id])
}

model GymSessionRate {
  id             String   @id @default(uuid())
  ratePerSession Float // INR per platform check-in
  effectiveFrom  DateTime // history per rate change
  isActive       Boolean  @default(true) // one active per gym
  gymId          String
  gym            Gym      @relation(fields: [gymId], references: [id])
  setByAdminId   String
  setByAdmin     User     @relation(fields: [setByAdminId], references: [id])
  createdAt      DateTime @default(now())
}

model SessionPayout {
  id            String       @id @default(uuid())
  amount        Float // snapshot of ratePerSession
  status        String // PENDING|BATCHED|PAID|FAILED
  createdAt     DateTime     @default(now())
  checkInId     String       @unique // 1:1 with CheckIn
  checkIn       CheckIn      @relation(fields: [checkInId], references: [id])
  gymId         String
  gym           Gym          @relation(fields: [gymId], references: [id])
  profileId     String
  profile       Profile      @relation(fields: [profileId], references: [id])
  payoutBatchId String?
  payoutBatch   PayoutBatch? @relation(fields: [payoutBatchId], references: [id])
}

model PayoutBatch {
  id                 String          @id @default(uuid())
  totalAmount        Float
  sessionPayoutTotal Float // stream 2
  gymPlanTotal       Float // stream 1 (95%)
  status             String // PENDING|PROCESSING|PAID|FAILED
  razorpayPayoutRef  String?
  periodStart        DateTime
  periodEnd          DateTime
  createdAt          DateTime        @default(now())
  gymId              String
  gym                Gym             @relation(fields: [gymId], references: [id])
  ownerId            String
  owner              User            @relation(fields: [ownerId], references: [id])
  sessionPayouts     SessionPayout[]
}

model OwnerBankAccount {
  id                    String   @id @default(uuid())
  accountHolderName     String
  accountNumber         String // encrypted at rest
  ifscCode              String
  razorpayFundAccountId String? // Razorpay Payout API ref
  isVerified            Boolean  @default(false) // penny-drop
  isPrimary             Boolean  @default(false)
  createdAt             DateTime @default(now())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
}
